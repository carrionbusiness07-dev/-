# Скопируйте в .env и заполните. .env в git не коммитится.

# Пароль PostgreSQL в docker-compose. Применяется только при первом создании тома БД.
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(24))"
# DATABASE_URL для docker-compose собирается из него автоматически.
POSTGRES_PASSWORD=

# Только для запуска без docker (локальная разработка):
# DATABASE_URL=sqlite:///minsk_realty.db

# Соль для псевдонимов продавцов. Сгенерировать один раз: python -c "import secrets;print(secrets.token_hex(32))"
# НЕ МЕНЯТЬ после запуска: иначе пропадёт связь «тот же продавец» для старых данных.
SELLER_KEY_SALT=

# Telegram. Один бот на всё: алерты сборщика администратору и бот для пользователей
# (сервис bot в docker-compose). Без токена сборщик пишет алерты только в лог,
# а сервис bot не запускается.
TELEGRAM_BOT_TOKEN=
# Ваш chat id: сюда приходят алерты, отсюда работает /weekly (предпросмотр и публикация сводки)
ADMIN_CHAT_ID=
# Канал для недельной сводки: @имя_канала или -100…; бот должен быть администратором канала.
# Пусто — сводка не публикуется.
CHANNEL_ID=
# Сколько квартир пользователь может держать в «Моих квартирах» (по умолчанию 10)
BOT_WATCH_LIMIT=10
# Как часто бот проверяет новые события для уведомлений, минут (по умолчанию 10)
BOT_NOTIFY_EVERY_MIN=10

# Внешний сторож (необязательно): адрес проверки healthchecks.io вида https://hc-ping.com/…
# Сборщик шлёт туда пустой сигнал после каждого цикла. Нет сигнала 2 часа — сторож сам пишет
# вам (выключился свет, пропал интернет, закрылся Docker). Как настроить — docs/setup-home-computer.md.
HEALTHCHECK_URL=

LOG_LEVEL=INFO
