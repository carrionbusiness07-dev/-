# Скопируйте в .env и заполните. .env в git не коммитится.

# Пароль PostgreSQL в docker-compose. Применяется только при первом создании тома БД.
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(24))"
# DATABASE_URL для docker-compose собирается из него автоматически.
POSTGRES_PASSWORD=

# Только для запуска без docker (локальная разработка):
# DATABASE_URL=sqlite:///minsk_realty.db

# Соль для псевдонимов продавцов. Сгенерировать один раз: python -c "import secrets;print(secrets.token_hex(32))"
# НЕ МЕНЯТЬ после запуска: иначе пропадёт связь «тот же продавец» для старых данных.
SELLER_KEY_SALT=

# Алерты администратору в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

LOG_LEVEL=INFO
